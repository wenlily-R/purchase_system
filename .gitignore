# 虚拟环境
.venv/
__pycache__/
*.pyc

# 临时文件
.hermes-tmp.*
data/.hermes-tmp.*

# 业务数据库(每台机器各自本地数据,不同步)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.bak_*
data/*.db.init
data/*.db.init-shm
data/*.db.init-wal
backup/

# 钉钉/飞书凭据备份(含AppSecret,严禁入库)
data/dingtalk_config_backup*.json

# 公网隧道地址(每台机器不同)
data/public_url.txt

# Windows 遗留/运行产物
data/cloudflared.exe
data/_*.png
data/_*.vbs
data/callback_registered.txt
data/watchdog.py

# 备份文件
*.bak_*
.DS_Store

# V11.126: 运行日志
app_run*.log
app_watchdog2.log

# 运行日志(全部)
*.log

# 业务单据附件(真实数据,不同步), 仅保留生成合同/单据用的模板
uploads/*
!uploads/tpl_*.docx
uploads/signatures/
